// Install with `hk install --mise` to ensure local tools are available
// The hk version is pinned by hk_version in copier.yml
// Skip with `HK=0` or `git ... --no-verify`
//
// `amends`/`import` must be the first module members and cannot interpolate a
// pkl `local`, so copier substitutes the version literal at generation time.

amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Builtins.pkl"

min_hk_version = "1.53.0"

// Builtins carry a `check_diff`, so a clean file is never rewritten and hk
// stages exactly the files each step touched (`stage = "<JOB_FILES>"` default).
local linters = new Mapping<String, Step> {
    ["actionlint"] = Builtins.actionlint
    ["check-added-large-files"] = Builtins.check_added_large_files
    ["check-merge-conflict"] = Builtins.check_merge_conflict
    ["check-symlinks"] = Builtins.check_symlinks
    ["detect-private-key"] = Builtins.detect_private_key
    ["ls-lint"] {
        check = "ls-lint"
    }
    ["mixed-line-ending"] = Builtins.mixed_line_ending
    ["newlines"] = Builtins.newlines
    ["pkl"] = Builtins.pkl
    // Matches the tombi LSP that formats TOML on save in nvim, so the editor
    // and the hook agree. `Builtins.tombi` (the linter) is deliberately absent:
    // it validates against Schema Store and rejects valid-but-unschema'd keys.
    ["tombi-format"] = Builtins.tombi_format
    ["trailing-whitespace"] = Builtins.trailing_whitespace
}

local commit_msg_checks = new Mapping<String, Step> {
    ["commitizen"] {
        check = "cz check --allow-abort --commit-msg-file={{commit_msg_file}}"
    }
}

local pre_push_checks = new Mapping<String, Step> {
    ["ci"] {
        check = "mise run ci"
    }
    ["commitizen-branch"] {
        check = "cz check --rev-range origin/HEAD..HEAD"
    }
}

hooks = new {
    ["pre-commit"] {
        fix = true
        stash = "patch-file"
        steps = linters
    }
    ["pre-push"] {
        steps = new {
            ...pre_push_checks
            ...linters
        }
    }
    ["commit-msg"] {
        steps = commit_msg_checks
    }

    // "fix" and "check" back the `hk fix` and `hk check` commands
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = new {
            ...pre_push_checks
            ...linters
        }
    }
}
